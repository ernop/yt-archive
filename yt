# Run the archive CLI with the framesheet venv (torch / open_clip / TransNetV2).
ROOT="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
PY="${YT_ARCHIVE_PYTHON:-/home/ef/proj/mybrowser/framesheets/.venv/bin/python}"
exec "$PY" -m yt_archive "$@"
