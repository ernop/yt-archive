#!/bin/sh
# Run the archive CLI with this repo's ML venv (torch / open_clip / TransNetV2).
ROOT="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
PY="$ROOT/.venv/bin/python"
if [ ! -x "$PY" ]; then
    echo "missing $PY — create it: docs/setup.md" >&2
    exit 1
fi
exec "$PY" -m yt_archive "$@"
